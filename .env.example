# ─────────────────────────────────────────────────────────────────────────
# Área de Membros 2.0 — variáveis de ambiente
# Copie pra .env e preencha. NÃO commitar o .env real.
# Em produção (EasyPanel) setar todas como env vars do container.
# ─────────────────────────────────────────────────────────────────────────

# Banco (obrigatório)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Secrets — se NÃO setar, o servidor auto-gera e persiste em uploads/.secrets.json.
# Em produção, SEMPRE setar pra estabilidade entre restart/réplicas.
JWT_SECRET=                       # >= 32 chars, aleatório
SESSION_SECRET=                   # >= 16 chars
DESKTOP_ACCESS_KEY=               # opcional, libera /admin no desktop

# Admin inicial (só usado no primeiro boot, ignorado depois)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Porta / ambiente
PORT=3000
NODE_ENV=production

# ─── BUNNY STREAM ────────────────────────────────────────────────────────
# Necessário pra tocar vídeos hospedados no Bunny Video Library (chamadas
# e galeria de produto). Sem esses 2 valores:
#   - O backend NÃO retorna bunny_hls_url → cliente cai no <video src> MP4
#     direto, que NÃO funciona com links player.mediadelivery.net/play/...
#   - O endpoint admin de "Testar Collection" responde 503.
#
# Onde encontrar:
#   1) BUNNY_HLS_HOST: Painel Bunny → Stream → sua Video Library → aba "API"
#      → campo "Pull Zone URL" / "CDN Hostname". Formato vz-XXXXXX-XXX.b-cdn.net.
#   2) BUNNY_API_KEY: Painel Bunny → Stream → sua Video Library → aba "API"
#      → campo "AccessKey". É a chave DA LIBRARY, não a global da conta.
BUNNY_HLS_HOST=
BUNNY_API_KEY=
